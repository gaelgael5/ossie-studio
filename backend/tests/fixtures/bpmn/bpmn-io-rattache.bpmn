<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:urban="https://github.com/gaelgael5/urban-bpmn/schema/1.0" id="PRC-VENTE-DETAIL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1" name="Vente en ligne">
    <bpmn:extensionElements><urban:reference cle="COL-VENTE-EN-LIGNE" type="collaboration" /></bpmn:extensionElements>
    <bpmn:participant id="Pool_Client" name="Client">
      <bpmn:extensionElements><urban:reference cle="ACT-CLIENT" type="acteur" /></bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="Pool_Boutique" name="Boutique" processRef="Process_1" />
    <bpmn:messageFlow id="Flow_M" sourceRef="Pool_Client" targetRef="Task_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Prise de commande" isExecutable="false">
    <bpmn:extensionElements><urban:reference cle="PRC-PRISE-COMMANDE" type="processus-metier" /></bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Vendeur" name="Vendeur (ancien nom)">
        <bpmn:extensionElements><urban:reference cle="ROL-VENDEUR" type="role" /></bpmn:extensionElements>
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" />
    <bpmn:task id="Task_1" name="Saisir la commande" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_1" />
    <bpmn:dataObjectReference id="Data_1" name="Commande" dataObjectRef="DataObject_1">
      <bpmn:extensionElements><urban:reference cle="OBJ-COMMANDE" type="objet-metier" /></bpmn:extensionElements>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Pool_Boutique_di" bpmnElement="Pool_Boutique" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="600" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="232" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="320" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="300" />
        <di:waypoint x="320" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
