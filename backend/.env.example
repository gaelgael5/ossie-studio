# Copier en .env et adapter. Ne jamais versionner le .env réel.

# Base PostgreSQL (celle du docker-compose.yml à la racine du dépôt)
DATABASE_URL=postgresql+asyncpg://ossie:ossie@localhost:5432/ossie_studio

# Secret de signature des cookies de session — générer avec : openssl rand -hex 32
SESSION_SECRET=

# Clé maître de chiffrement des secrets (32 octets hex) — openssl rand -hex 32
# Obligatoire : sans elle le service refuse de démarrer, jamais de clé par défaut.
# La perdre rend les secrets déjà chiffrés illisibles. À sauvegarder hors machine.
SECRETS_MASTER_KEY=

# true derrière HTTPS (cookies Secure). Requis en production pour que le
# flux OIDC (cookie de session portant state/nonce/PKCE) soit protégé.
SESSION_COOKIE_SECURE=false
