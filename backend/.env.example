# Copier en .env et adapter. Ne jamais versionner le .env réel.
# En déploiement, dev-deploy.sh génère les secrets manquants.

# Base PostgreSQL (asyncpg). Le préfixe +asyncpg est toléré et retiré.
DATABASE_URL=postgresql://ossie:ossie@localhost:5432/ossie_studio

# Les deux volumes mappés (obligatoires) : sans eux le backend refuse de démarrer.
# - volume de travail : copies de travail des espaces Git (versionnées)
# - volume des sources : code descendu des sources (jamais versionné)
WORK_VOLUME_PATH=./data/work
SOURCES_VOLUME_PATH=./data/sources

# Secret de signature des cookies de session — openssl rand -hex 32
SESSION_SECRET=

# Clé maître de chiffrement des secrets (32 octets hex) — openssl rand -hex 32
# Obligatoire : sans elle le service refuse de démarrer, jamais de clé par défaut.
SECRETS_MASTER_KEY=

# true derrière HTTPS (cookies Secure). Requis en production.
SESSION_COOKIE_SECURE=false
